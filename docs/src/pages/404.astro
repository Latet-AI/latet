---
// The page for an address that does not exist, drawn by Starlight like its own.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: '404',
		template: 'splash',
		editUrl: false,
		pagefind: false,
		hero: { tagline: Astro.locals.t('404.text'), actions: [] },
	}}
/>
